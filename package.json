{
  "name": "colors-lab",
  "version": "1.0.0",
  "description": "The COLORS application is a web browser that allows its users to add colors to a database and search for the colors within the database.",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test_watch": "jest --watch",
    "lint:js": "eslint public/js",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"**/node_modules/**\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karmaxenn/COLORS-LAB.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Karmaxenn/COLORS-LAB/issues"
  },
  "homepage": "https://github.com/Karmaxenn/COLORS-LAB#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
